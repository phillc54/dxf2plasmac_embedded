; configure a temporary material
(o=0, nu=1, na=1mm steel, ph=3.1, pd=0.1, ch=1.0, fr=1001, kw=1.1)

#<h_velocity> = 60 ; small hole velocity = 60%
#<h_diameter> = 32 ; small hole diameter
#<holes> = 1 ; reduce velocity  for small holes

G21 ; units in millimeters
G40 ; cancel cutter compensation
G49 ; cancel tool compensation
G64 P0.1 ; path blending tolerance
G80 ; cancel canned cycle
G90 ; absolute positioning
G92.1 ; cancel G92 offsets
G94 ; feed rate = units per minute
G97 ; spindle mode = rpm

F#<_hal[plasmac.cut-feed-rate]> ; set feed rate

;layer 0, cut #1
